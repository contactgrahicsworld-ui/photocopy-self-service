# Smart Photocopy — environment variables (fill real values; nothing has insecure defaults)
DATABASE_URL=file:/absolute/path/to/db/custom.db   # dev: SQLite. prod: Supabase pooler URL (see README §2)
SESSION_SECRET=<openssl rand -hex 32>              # signs admin sessions & short-lived file tokens
CRON_SECRET=<openssl rand -hex 16>                 # protects /api/cron/sweep (Vercel Cron sends it automatically)
SETUP_TOKEN=<openssl rand -hex 16>                 # one-time platform owner creation at /setup
FILE_STORAGE_DIR=/absolute/path/to/db/uploads      # private customer documents (local backend)
STORAGE_BACKEND=local                              # local | supabase (prod/serverless = supabase)
SUPABASE_URL=                                      # e.g. https://abcdefgh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=                         # server-only secret, never expose to the browser
SUPABASE_STORAGE_BUCKET=documents                  # private bucket for customer PDFs
MAX_UPLOAD_MB=20
BASE_URL=https://your-domain
SUPER_ADMIN_EMAIL=                                 # dev seeding only (demo environments)
SUPER_ADMIN_PASSWORD=                              # dev seeding only
DEMO_SHOP_EMAIL=                                   # dev seeding only
DEMO_SHOP_PASSWORD=                                # dev seeding only
